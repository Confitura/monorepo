{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(backlog task *)",
      "Bash(backlog doc *)",
      "Bash(git switch --no-track -c factory/*)",
      "Bash(git switch --no-track -C factory/*)",
      "Bash(git push -u origin factory/*)",
      "Bash(git push origin factory/*)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm codegen*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test:unit*)",
      "Bash(pnpm test --run*)",
      "Bash(pnpm build*)",
      "Bash(gh pr create --base master --head factory/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr edit * --body-file *)",
      "Bash(gh pr comment * --body-file *)",
      "Bash(gh run view *)",
      "Bash(gh api \"repos/{owner}/{repo}/code-scanning/alerts?pr=*)",
      "Bash(gh api \"repos/{owner}/{repo}/pulls/*/comments?per_page=100\"*)",
      "Bash(gh api -X POST \"repos/{owner}/{repo}/pulls/*/comments/*/replies\" -F body=@*)",
      "Bash(gh auth status*)",
      "Bash(git fetch origin --prune*)",
      "Bash(git merge --ff-only origin/master*)",
      "Bash(git merge --no-edit origin/master*)",
      "Bash(git merge --abort*)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current*)",
      "Bash(git branch --list *)",
      "Bash(git branch -D factory/*)",
      "Bash(git switch master*)",
      "Bash(cd jelatyna-backend && ./mvnw *)",
      "Bash(cd admin-app && pnpm *)",
      "Bash(cd webpage && pnpm *)",
      "Bash(java -version*)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *master*)",
      "Bash(gh api *code-scanning/alerts/*)"
    ]
  }
}
