    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rollup-plugin-regexp": "^5.0.1",
    "sass-embedded": "^1.103.1",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^8.2.2",
    "vite-plugin-vue-meta-layouts": "^0.6.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
