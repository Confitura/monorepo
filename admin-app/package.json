    "md-editor-v3": "^6.5.6",
    "pinia": "^3.0.4",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-echarts": "^8.1.0",
    "vue-markdown-render": "^2.3.1",
    "vue-router": "^4.6.4",
    "vuetify": "4.1.12"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@mdi/js": "^7.4.47",
    "@nuxt/eslint-config": "^1.17.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
