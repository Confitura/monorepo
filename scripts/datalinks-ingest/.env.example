# Datalinks (dev). Get a token from Settings > Tokens & API (viewable only at creation).
# Interactive API docs: https://api.dev.datalinks.com/openapi/ui/index.html
DATALINKS_BASE_URL=https://api.dev.datalinks.com/api/v1
DATALINKS_TOKEN=
DATALINKS_USERNAME=
DATALINKS_NAMESPACE=confitura-2026

# Public Confitura resource files (unauthenticated static JSON).
RESOURCES_BASE_URL=https://api.confitura.pl/api/resources/edition-2026

# Comma-separated CMS page slugs to ingest (from /pages/<slug>.json).
# FAQ is ingested separately from the structured /faq/entries.json, not as a page.
RESOURCES_PAGES=venue,about,spoina,privacy-policy

# Comma-separated agenda day ids to ingest (from /agenda/<dayId>.json). Leave empty to skip.
AGENDA_DAYS=day-1,day-2
